        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let response = pm.response.json();\nif(response.data) {\n    if(response.data.access_token) {\n        pm.environment.set(\"BEARER_ACCESS_TOKEN\", response.data.access_token);\n    }\n    if(response.data.refresh_token) {\n        pm.environment.set(\"BEARER_REFRESH_TOKEN\", response.data.refresh_token);\n    }\n}\n\npm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response has message Done\", function () {\n    pm.expect(response.message).to.eql(\"Done\");\n});\n"
                ]
              }
            }
          ],
